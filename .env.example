# PostgreSQL connection string (Railway injects this automatically when you add a Postgres plugin)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Admin panel password (change it!)
ADMIN_PASSWORD="change-me"

# Secret to sign the admin session cookie (use a long random string)
SESSION_SECRET="generate-a-long-random-string"

# Your WhatsApp number with country code, digits only (e.g. Colombia: 57 + number)
NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"
